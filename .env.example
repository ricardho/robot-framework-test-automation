# Template for the local .env file (git-ignored). Copy it and fill in the values:
#   Windows:     copy .env.example .env
#   Linux/macOS: cp .env.example .env
#
# Resolution order: robot --variable > environment variable > .env > config/settings.toml > default.
# In CI these values come from GitHub repository secrets.

# ----- Secrets (required) -----
# Password of the project administrator account (SERVEREST_ADMIN_EMAIL).
# Choose any strong value: the tests create the account with it when it does not exist.
# Use the same value in the GitHub repository secret SERVEREST_ADMIN_PASSWORD.
SERVEREST_ADMIN_PASSWORD=

# ----- Optional overrides (defaults live in config/settings.toml) -----
# API_BASE_URL=https://serverest.dev
# BASE_URL=https://front.serverest.dev
# BROWSER=chromium          # chromium | firefox | webkit
# HEADLESS=true
# TIMEOUT=15s
# MOBILE_DEVICE_IOS=iPhone 14
# MOBILE_DEVICE_ANDROID=Pixel 7
# APPIUM_URL=http://127.0.0.1:4723
# SERVEREST_ADMIN_EMAIL=rf-automation.admin@example.com
# EVIDENCE_MODE=failure     # failure | always | steps
# EVIDENCE_PDF=true
# EVIDENCE_DIR=results/evidence
